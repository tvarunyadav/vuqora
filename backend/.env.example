# VUQORA Backend Environment Configuration Example
# Copy to .env for local development

# Application Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database Configuration
# Production uses Neon PostgreSQL (postgresql+asyncpg://...)
# Local development default PostgreSQL connection:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vuqora_dev

# AI Credentials (Backend-only, DO NOT expose to frontend)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
